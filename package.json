{
  "name": "defillama-gateway",
  "version": "0.1.0",
  "description": "Chain to DApp listing gateway for ZeroWallet using DefiLlama protocols data",
  "engines": {
    "node": ">=18"
  },
  "main": "src/index.ts",
  "scripts": {
    "start": "cp -n .env.example .env 2>/dev/null; wrangler dev",
    "dev": "wrangler dev",
    "deploy": "dotenv -- wrangler deploy",
    "build-chain-ids": "tsx scripts/build-chain-id-map.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "generate-sdk": "bash scripts/generate-flutter-sdk.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@types/node": "^25.6.2",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0",
    "wrangler": "^3.0.0"
  },
  "dependencies": {
    "hono": "^4.12.16"
  }
}
